# The XIAO ESP32-S3: 8 MB flash, console on the S3's own USB-Serial/JTAG; 240 MHz and -O2 as the
# firmware builds (the core's sdkconfig.defaults); one CPU-bound task, so no task watchdog.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A task that runs past its stack panics at the first byte (a hardware watchpoint), not later in the
# scheduler (the canary alone let a casim overflow surface as LoadProhibited in vTaskSwitchContext).
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# Every stack is read with interrupts masked around the run (abacus #6321), and the slowest cases run past the interrupt
# watchdog's default 300 ms (a factor case takes 0.85 s): 2 s, for this bench only.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000
